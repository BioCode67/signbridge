# Cloudflare Pages / Netlify 헤더 규칙.
#
# 이 파일은 정적 호스팅이 그대로 읽어 응답 헤더를 붙인다. 로컬 개발 서버는 무시한다.

# 해시가 붙은 번들은 내용이 바뀌면 이름이 바뀐다 — 영구 캐시해도 안전하다.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 동작 조각·모델은 이름이 그대로라 영구 캐시하면 사전을 다시 만들어도 옛것이 나온다.
# 하루만 캐시하고, 그 뒤에는 서버에 물어본다(바뀌지 않았으면 304로 끝난다).
/data/glosses/*
  Cache-Control: public, max-age=86400, must-revalidate
/models/*
  Cache-Control: public, max-age=86400, must-revalidate
/mediapipe/*
  Cache-Control: public, max-age=86400, must-revalidate

# 서비스워커는 절대 캐시하면 안 된다 — 캐시되면 새 배포가 영영 안 내려간다.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  # 카메라·마이크·위치는 이 사이트에서만. 광고·추적 API는 전부 막는다.
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), interest-cohort=()
