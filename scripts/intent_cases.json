{
  "_주석": [
    "수어 낱말 묶음 → 의도 판정 사례.",
    "words는 인식기가 확정한 글로스, alts는 낱말별 상위 후보(0번이 words와 같다).",
    "expect가 null이면 '의도 없음'이 정답이다 — 재난 상황에서 엉뚱한 대피소를",
    "알려주는 것은 모르겠다고 답하는 것보다 나쁘다. 그래서 오검출 사례를 많이 둔다.",
    "alts는 실제 인식 실패를 흉내 낸 것이다: 1순위가 틀리고 2~3순위에 정답이 있는 경우",
    "(실측 top-1 0.7863 / top-5 0.9188 — 다섯 번에 한 번은 1순위가 틀린다)."
  ],
  "cases": [
    { "이름": "대피소 어디 (기본)", "words": ["대피0", "어디"], "expect": "where:shelter" },
    { "이름": "어디 대피 (어순 반대)", "words": ["어디", "대피0"], "expect": "where:shelter" },
    { "이름": "대피만 — 1순위로 확실하면 질문으로 본다(비수지를 못 읽으므로)", "words": ["대피0"], "expect": "where:shelter" },
    { "이름": "대피 장소", "words": ["대피0", "장소1"], "expect": "where:shelter" },
    { "이름": "학교 어디", "words": ["학교1", "어디"], "expect": "where:shelter" },
    { "이름": "병원 어디", "words": ["병원1", "어디"], "expect": "where:hospital" },
    { "이름": "어디 병원 가다", "words": ["어디", "병원1", "가다1"], "expect": "where:hospital" },
    { "이름": "약국 어디", "words": ["약국0", "어디"], "expect": "where:pharmacy" },
    { "이름": "경찰서 어디", "words": ["경찰서1", "어디"], "expect": "where:police" },
    { "이름": "지하철 어디", "words": ["지하철1", "어디"], "expect": "where:subway" },
    { "이름": "화장실 어디", "words": ["화장실0", "어디"], "expect": "where:toilet" },

    { "이름": "1순위가 틀렸지만 2순위에 대피",
      "words": ["도망0", "어디"],
      "alts": [["도망0", "대피0", "피하다"], ["어디", "어느"]],
      "expect": "where:shelter" },
    { "이름": "1순위가 전혀 다른 낱말, 3순위에 병원",
      "words": ["방0", "어디"],
      "alts": [["방0", "집1", "병원1"], ["어디", "언제"]],
      "expect": "where:hospital" },
    { "이름": "질문 낱말이 후보에만 있음",
      "words": ["약국0", "언제"],
      "alts": [["약국0"], ["언제", "어디"]],
      "expect": "where:pharmacy" },

    { "이름": "지진 지금 무슨 일", "words": ["지진1", "지금"], "expect": "whatsup" },
    { "이름": "무엇 지진", "words": ["무엇", "지진1"], "expect": "whatsup" },
    { "이름": "불 뭐", "words": ["불1", "뭐"], "expect": "whatsup" },
    { "이름": "지진 어떻게 하다", "words": ["지진1", "하다"], "expect": "howto" },
    { "이름": "도와주세요", "words": ["돕다"], "expect": "help" },

    { "이름": "빈 입력", "words": [], "expect": null },
    { "이름": "관계없는 낱말 하나", "words": ["사과1"], "expect": null },
    { "이름": "대피가 2순위로만 잡히면 판정하지 않는다", "words": ["방0"], "alts": [["방0", "대피0"]], "expect": null },
    { "이름": "관계없는 낱말 셋", "words": ["사과1", "노래0", "빨강1"], "expect": null },
    { "이름": "어디만 (무엇을 묻는지 모름)", "words": ["어디"], "expect": null },
    { "이름": "지금만", "words": ["지금"], "expect": null },
    { "이름": "밥 먹다 — 질문이 아님", "words": ["밥0", "먹다1"], "expect": null },
    { "이름": "후보 낮은 순위 낱말만으로는 판정하지 않음",
      "words": ["사과1", "노래0"],
      "alts": [["사과1", "학교1"], ["노래0", "어디"]],
      "expect": null }
  ]
}
